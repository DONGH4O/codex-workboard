{
  "name": "codex-workboard",
  "version": "1.0.0",
  "private": true,
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true
  },
  "author": "new school",
  "license": "MIT",
  "description": "Local-first desktop work board for organizing Codex conversations and audited tasks",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && node scripts/dev-electron.mjs",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "test": "vitest run",
    "test:w2:protocol": "node scripts/verify-w2-protocol-schema.mjs",
    "test:w2:preflight": "npm run build:main && node scripts/qa-w2-preflight.mjs",
    "test:w3:isolated": "npm run build:main && vitest run scripts/w3-qa-safety.test.mjs scripts/qa-create-thread.test.mjs scripts/qa-live-appserver.test.mjs electron/codexBridge.lifecycle.test.ts",
    "test:ui:offline": "node scripts/qa-offline-ui.mjs",
    "test:ui": "node scripts/qa-electron.mjs",
    "test:flow": "node scripts/qa-formal-flow.mjs",
    "w3:real:basic-create": "npm run build:main && node scripts/qa-create-thread.mjs --execute-real --scenario=basic-create",
    "w3:real:list-sync": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=list-sync",
    "w3:real:read-existing": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=read-existing",
    "w3:real:steer": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=steer",
    "w3:real:interrupt": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=interrupt",
    "w3:real:approval-decline": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=approval-decline",
    "w3:real:approval-once": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=approval-once",
    "w3:real:approval-session": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=approval-session",
    "w3:real:user-input-answer": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=user-input-answer",
    "w3:real:user-input-cancel": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=user-input-cancel",
    "w3:real:user-input-timeout": "npm run build:main && node scripts/qa-live-appserver.mjs --execute-real --scenario=user-input-timeout",
    "daily:maintenance": "npm run build:main && node scripts/daily-maintenance.mjs",
    "start": "electron .",
    "pack": "npm run pack:mac",
    "pack:mac": "npm run build && electron-builder --mac dir",
    "pack:win": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "verify:win-package": "node scripts/verify-windows-package.mjs",
    "data:backup": "npm run build:main && node scripts/workboard-data.mjs backup",
    "data:restore": "npm run build:main && node scripts/workboard-data.mjs restore",
    "workboard:start": "npm run build:main && node scripts/workboard-run-control.mjs start",
    "workboard:status": "npm run build:main && node scripts/workboard-run-control.mjs status",
    "workboard:stop": "npm run build:main && node scripts/workboard-run-control.mjs stop",
    "audit:security": "npm audit --registry=https://registry.npmjs.org --audit-level=high",
    "release:check": "npm test && npm run build && npm run audit:security && node scripts/release-check.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "43.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.17.0",
  "build": {
    "appId": "com.codexworkboard.desktop",
    "productName": "Codex Workboard",
    "asar": true,
    "files": [
      "dist-electron/**/*.js",
      "!dist-electron/**/*.test.js",
      "dist-electron/preload.cjs",
      "dist-renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "deleteAppDataOnUninstall": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
